#!/usr/bin/env bash
# Regenerate tandem.lua from the plugin's settings in shell.json, make sure
# hyprland.lua loads it, and reload Hyprland.
#
# Settings live under the plugin's bar entry in ~/.config/omarchy/shell.json:
#
#   { "id": "videinfra.tandem", "settings": {
#       "monitors": ["DP-1", "DP-3"],   // in order; omit to autodetect
#       "desktops": 2,
#       "toggle":   "SUPER + F",
#       "send":     "SUPER + SHIFT + F",
#       "numbers":  true,               // SUPER+1..n jump to a desktop
#       "tab":      true,               // SUPER+TAB cycles
#       "scroll":   true                // SUPER+scroll cycles
#   } }
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHELL_JSON="${OMARCHY_SHELL_JSON:-$HOME/.config/omarchy/shell.json}"
HYPRLAND_LUA="${TANDEM_HYPRLAND_LUA:-$HOME/.config/hypr/hyprland.lua}"
OUT="$HERE/tandem.lua"
LOADER='pcall(dofile, (os.getenv("HOME") or "") .. "/.config/omarchy/plugins/videinfra.tandem/tandem.lua")'

command -v jq >/dev/null || { echo "tandem-apply: jq is required" >&2; exit 1; }
[[ -f $HERE/body.lua ]] || { echo "tandem-apply: body.lua missing next to this script" >&2; exit 1; }

# ---- read settings (with defaults) ------------------------------------------
settings='{}'
if [[ -f $SHELL_JSON ]]; then
  settings=$(jq -c '[.. | objects | select(.id == "videinfra.tandem" and (.role // "") != "settings") | (del(.id) | del(.settings)) + (.settings // {})] | first // {}' "$SHELL_JSON" 2>/dev/null || echo '{}')
  [[ -n $settings && $settings != "null" ]] || settings='{}'
fi

# Not `.key // $default` -- jq's // also swallows `false`, which would silently
# turn every disabled boolean back on.
get() {
  jq -r --arg k "$1" --arg d "$2" \
    'if has($k) and .[$k] != null then .[$k] else $d end' <<<"$settings"
}

DESKTOPS=$(get desktops 2)
TOGGLE=$(get toggle "SUPER + F")
SEND=$(get send "SUPER + SHIFT + F")
NUMBERS=$(get numbers true)
TAB=$(get tab true)
SCROLL=$(get scroll true)
ANIMATION=$(get animation slide)

case "$ANIMATION" in
slide | slidevert | fade | slidefade | slidefadevert | none) ;;
*)
  echo "tandem-apply: unknown animation '$ANIMATION'" >&2
  exit 1
  ;;
esac

[[ $DESKTOPS =~ ^[0-9]+$ ]] && (( DESKTOPS >= 1 && DESKTOPS <= 10 )) \
  || { echo "tandem-apply: 'desktops' must be 1-10, got '$DESKTOPS'" >&2; exit 1; }

for pair in "toggle:$TOGGLE" "send:$SEND"; do
  name=${pair%%:*}; value=${pair#*:}
  [[ $value == *'"'* || -z $value ]] \
    && { echo "tandem-apply: '$name' is not a usable key spec: '$value'" >&2; exit 1; }
done
: # keys look sane

# Monitors: explicit list, else autodetect ordered top-to-bottom then left-to-right.
monitors=$(jq -r '.monitors // empty | .[]' <<<"$settings" 2>/dev/null || true)
if [[ -z $monitors ]]; then
  command -v hyprctl >/dev/null \
    || { echo "tandem-apply: no 'monitors' setting and hyprctl unavailable" >&2; exit 1; }
  monitors=$(hyprctl monitors -j | jq -r 'sort_by(.y, .x) | .[].name')
fi
[[ -n $monitors ]] || { echo "tandem-apply: no monitors resolved" >&2; exit 1; }

lua_list=""
while IFS= read -r name; do
  [[ -n $name ]] || continue
  [[ $name == *'"'* ]] && { echo "tandem-apply: bad monitor name '$name'" >&2; exit 1; }
  lua_list+="\"$name\", "
done <<<"$monitors"
lua_list="${lua_list%, }"

# ---- generate ---------------------------------------------------------------
tmp=$(mktemp)
{
  echo "-- GENERATED by tandem-apply -- do not edit."
  echo "-- Change these through the plugin's settings in shell.json, then re-run"
  echo "-- $HERE/tandem-apply"
  echo "--"
  echo "-- Virtual desktops: every monitor switches together, KDE-style."
  echo "-- A desktop owns one workspace per monitor:"
  echo "--   workspace = (desktop - 1) * #MONITORS + monitor_index"
  echo ""
  echo "local MONITORS = { $lua_list }"
  echo "local DESKTOPS = $DESKTOPS"
  echo "local ANIMATION = \"$ANIMATION\""
  echo "local KEYS = {"
  echo "  toggle  = \"$TOGGLE\","
  echo "  send    = \"$SEND\","
  echo "  numbers = $NUMBERS,"
  echo "  tab     = $TAB,"
  echo "  scroll  = $SCROLL,"
  echo "}"
  echo ""
  cat "$HERE/body.lua"
} >"$tmp"

if command -v luac >/dev/null && ! luac -p "$tmp" 2>/dev/null; then
  echo "tandem-apply: generated Lua failed to parse, keeping the previous file" >&2
  luac -p "$tmp" || true
  rm -f "$tmp"
  exit 1
fi
mv "$tmp" "$OUT"
echo "tandem-apply: wrote $OUT ($DESKTOPS desktops, monitors: $lua_list)"

# ---- make sure hyprland.lua loads it ----------------------------------------
# pcall+dofile so that removing the plugin directory leaves an inert line
# rather than a config error -- omarchy plugin remove has no uninstall hook.
if [[ -f $HYPRLAND_LUA ]]; then
  if grep -qF 'videinfra.tandem/tandem.lua' "$HYPRLAND_LUA"; then
    echo "tandem-apply: loader already present in $(basename "$HYPRLAND_LUA")"
  else
    cp "$HYPRLAND_LUA" "$HYPRLAND_LUA.bak.$(date +%s)"
    printf '\n-- Virtual desktops (videinfra.tandem). Inert if the plugin is removed.\n%s\n' \
      "$LOADER" >>"$HYPRLAND_LUA"
    echo "tandem-apply: added loader to $(basename "$HYPRLAND_LUA") (backed up first)"
  fi
else
  echo "tandem-apply: $HYPRLAND_LUA not found; add this line yourself:" >&2
  echo "  $LOADER" >&2
fi

# ---- reload -----------------------------------------------------------------
if command -v hyprctl >/dev/null && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  hyprctl reload >/dev/null
  errors=$(hyprctl configerrors 2>&1 || true)
  if [[ -n ${errors//[[:space:]]/} ]]; then
    echo "tandem-apply: hyprctl configerrors reported:" >&2
    echo "$errors" >&2
    exit 1
  fi
  echo "tandem-apply: reloaded, config clean"

  # Lowering the desktop count strands every window above the new last
  # workspace. Those workspaces keep existing because they hold windows, the
  # bar infers the desktop count from the highest live workspace, and the old
  # count stays on screen -- so the change looks like it did not take. They
  # also survive an uninstall. Move the windows down to the last desktop on
  # the monitor they are already on.
  monitor_count=$(wc -w <<<"${lua_list//,/ }")
  monitor_count=$(( monitor_count > 0 ? monitor_count : 1 ))
  last=$(( DESKTOPS * monitor_count ))
  moved=0
  while read -r address workspace; do
    [[ -n $address && $workspace =~ ^[0-9]+$ ]] || continue
    (( workspace > last )) || continue
    index=$(( (workspace - 1) % monitor_count + 1 ))
    target=$(( (DESKTOPS - 1) * monitor_count + index ))
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", workspace = \"$target\", follow = false })" >/dev/null 2>&1
    moved=$(( moved + 1 ))
  done < <(hyprctl clients -j 2>/dev/null | jq -r '.[] | "\(.address) \(.workspace.id)"')
  (( moved > 0 )) && echo "tandem-apply: moved $moved window(s) off retired desktops"

  # Hyprland only reaps a now-ruleless empty workspace when the monitor leaves
  # it, so without this the retired workspaces linger, the bar keeps inferring
  # the old desktop count from the highest live workspace, and the change looks
  # like it never applied. Switching once clears them.
  current=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // 1')
  [[ $current =~ ^[0-9]+$ ]] || current=1
  desk=$(( (current - 1) / monitor_count + 1 ))
  (( desk >= 1 && desk <= DESKTOPS )) || desk=1
  hyprctl dispatch "tandem_show($desk)" >/dev/null 2>&1
fi
