#!/usr/bin/env bash
# Interactive setup for the Virtual Desktops plugin.
#
# Asks how many desktops and which keys, writes the answers into the plugin's
# settings in shell.json, then hands off to tandem-apply to regenerate the
# Hyprland config. Non-interactive callers should edit shell.json and run
# tandem-apply directly.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHELL_JSON="${OMARCHY_SHELL_JSON:-$HOME/.config/omarchy/shell.json}"

for tool in gum jq; do
  command -v $tool >/dev/null || { echo "tandem-setup: $tool is required" >&2; exit 1; }
done
[[ -f $SHELL_JSON ]] || { echo "tandem-setup: $SHELL_JSON not found" >&2; exit 1; }

current() { jq -r --arg k "$1" --arg d "$2" \
  '[.. | objects | select(.id == "videinfra.tandem" and (.role // "") != "settings")
     | (del(.id) | del(.settings)) + (.settings // {})] | first // {}
   | if has($k) and .[$k] != null then .[$k] else $d end' "$SHELL_JSON"; }

echo "Virtual Desktops setup"
echo

# --- monitors ---------------------------------------------------------------
mapfile -t rows < <(hyprctl monitors -j \
  | jq -r 'sort_by(.y, .x) | .[] | "\(.name)\t\(.width)x\(.height)\t\(.x),\(.y)"')
count=${#rows[@]}
# Stacked screens differ in y, side-by-side ones in x. Label whichever axis
# actually varies, so "top/bottom" is never guessed at for a horizontal setup.
distinct_y=$(hyprctl monitors -j | jq -r '[.[].y] | unique | length')
if (( distinct_y > 1 )); then first_label=top; last_label=bottom
else first_label=left; last_label=right; fi

echo "Detected monitors, in order:"
for i in "${!rows[@]}"; do
  IFS=$'\t' read -r name res pos <<<"${rows[$i]}"
  label=""
  if (( count > 1 )); then
    if   (( i == 0 ));         then label="$first_label"
    elif (( i == count - 1 )); then label="$last_label"
    else                            label="middle"; fi
  fi
  printf "  %d. %-10s %-11s at %-10s %s\n" \
    "$((i + 1))" "$name" "$res" "$pos" "${label:+($label)}"
done
echo
echo "Desktop 1 puts workspace 1 on the first monitor, 2 on the second, and so on."
if gum confirm "Use this order?"; then
  monitors_json=null   # omit the key; tandem-apply autodetects the same way
else
  echo "Enter monitor names in order, space separated (e.g. DP-1 DP-3):"
  read -r -a picked
  [[ ${#picked[@]} -gt 0 ]] || { echo "tandem-setup: no monitors given" >&2; exit 1; }
  monitors_json=$(printf '%s\n' "${picked[@]}" | jq -R . | jq -sc .)
fi

# --- desktops ---------------------------------------------------------------
desktops=$(gum choose --header "How many virtual desktops?" \
  --selected "$(current desktops 2)" 2 3 4 5 6)
[[ -n $desktops ]] || exit 1

# --- keys -------------------------------------------------------------------
# One key drives both bindings: SUPER switches desktop, SUPER+SHIFT takes the
# focused window along. Asking for the two independently let them drift apart
# -- changing only the switch key left the send binding on the old one, so the
# change looked like it had not applied.
current_key=$(current toggle "SUPER + F")
current_key=${current_key##*+ }
current_key=${current_key:-F}

key=$(gum input --header "Key for switching desktops (used with SUPER)" \
  --value "$current_key")
key=${key## }
key=${key%% }
[[ -n $key ]] || { echo "tandem-setup: key cannot be empty" >&2; exit 1; }
[[ $key != *'"'* && $key != *+* ]] \
  || { echo "tandem-setup: give just the key, e.g. F -- SUPER is added for you" >&2; exit 1; }

toggle="SUPER + $key"
send="SUPER + SHIFT + $key"
echo "  switch desktop:   $toggle"
echo "  send window:      $send"

# One question per binding. A gum multi-select needs space to tick each row and
# enter only confirms what is already ticked, so pressing enter on a highlighted
# row silently selects nothing -- too easy to read as "yes" and end up with the
# bindings quietly disabled.
ask() {
  local prompt=$1 current=$2
  if [[ $current == true ]]; then
    gum confirm --default=yes "$prompt" && echo true || echo false
  else
    gum confirm --default=no "$prompt" && echo true || echo false
  fi
}

echo
numbers=$(ask "Bind SUPER+1..$desktops to jump straight to a desktop?" "$(current numbers true)")
tab=$(ask "Bind SUPER+TAB / SUPER+SHIFT+TAB to cycle desktops?" "$(current tab true)")
scroll=$(ask "Bind SUPER+scroll to cycle desktops?" "$(current scroll true)")
separator=$(ask "Draw a | between desktops in the bar?" "$(current separator false)")

# Which way the desktops appear to move when switching. Side-by-side monitors
# usually suit the horizontal slide; stacked ones often read better vertical.
animation=$(gum choose --header "Switching animation" \
  --selected "$(current animation slide)" \
  slide slidevert fade slidefade slidefadevert none)
[[ -n $animation ]] || animation=$(current animation slide)

echo
echo "  SUPER+1..$desktops: $numbers"
echo "  SUPER+TAB:        $tab"
echo "  SUPER+scroll:     $scroll"
echo "  separator:        $separator"
echo "  animation:        $animation"
echo

# --- desktop names ----------------------------------------------------------
existing_labels=$(jq -c '[.. | objects | select(.id == "videinfra.tandem" and (.role // "") != "settings") | (del(.id) | del(.settings)) + (.settings // {})] | first // {} | .labels // null' "$SHELL_JSON")
default_label() { printf 'D%s' "$1"; }

echo
if gum confirm --default=no "Give the desktops custom names? (default is D1..D$desktops)"; then
  labels="[]"
  for i in $(seq 1 "$desktops"); do
    current=$(jq -r --argjson i "$i" 'if type == "array" and length >= $i then .[$i-1] else null end' \
      <<<"$existing_labels")
    [[ $current == null || -z $current ]] && current=$(default_label "$i")
    name=$(gum input --header "Name for desktop $i" --value "$current")
    [[ -n $name ]] || name=$(default_label "$i")
    labels=$(jq -c --arg n "$name" '. + [$n]' <<<"$labels")
  done
  echo "  names: $(jq -r 'join(", ")' <<<"$labels")"
else
  labels=null
fi

# --- write settings ---------------------------------------------------------
settings=$(jq -nc \
  --argjson labels "$labels" \
  --argjson monitors "$monitors_json" \
  --argjson desktops "$desktops" \
  --arg toggle "$toggle" --arg send "$send" \
  --argjson numbers "$numbers" --argjson tab "$tab" --argjson scroll "$scroll" \
  --argjson separator "$separator" \
  --arg animation "$animation" \
  '{desktops: $desktops, toggle: $toggle, send: $send,
    numbers: $numbers, tab: $tab, scroll: $scroll, separator: $separator,
    animation: $animation}
   | if $monitors == null then . else .monitors = $monitors end
   | if $labels   == null then . else .labels   = $labels   end')

cp "$SHELL_JSON" "$SHELL_JSON.bak.$(date +%s)"
tmp=$(mktemp)
jq --argjson s "$settings" \
  '(.. | objects | select(.id == "videinfra.tandem" and (.role // "") != "settings")) |= ({id} + (if has("role") then {role} else {} end) + $s)' \
  "$SHELL_JSON" >"$tmp"
jq -e '[.. | objects | select(.id == "videinfra.tandem" and (.role // "") != "settings")] | length > 0' "$tmp" >/dev/null \
  || { echo "tandem-setup: widget not found in shell.json -- add it to the bar first" >&2
       rm -f "$tmp"; exit 1; }
mv "$tmp" "$SHELL_JSON"
echo "Saved settings to $SHELL_JSON (backed up first)."
echo

# `omarchy plugin add --enable` creates a single bar entry. The settings panel
# is a second entry of the same id, so add it the first time setup runs.
if ! jq -e '[.. | objects | select(.id == "videinfra.tandem" and (.role // "") == "settings")] | length > 0' \
  "$SHELL_JSON" >/dev/null; then
  tmp=$(mktemp)
  jq '.bar.layout.right = ([{"id": "videinfra.tandem", "role": "settings"}] + (.bar.layout.right // []))' \
    "$SHELL_JSON" >"$tmp"
  mv "$tmp" "$SHELL_JSON"
  echo "Added the settings widget to the right of the bar."
  command -v omarchy >/dev/null &&
    setsid sh -c 'sleep 0.5; omarchy restart shell' >/dev/null 2>&1 < /dev/null &
fi

exec "$HERE/tandem-apply"
