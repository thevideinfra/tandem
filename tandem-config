#!/usr/bin/env bash
# Read and write the Virtual Desktops settings.
#
# The settings panel is a thin front-end over this script, so all validation
# and file handling stays in one tested place rather than being reimplemented
# in QML.
#
#   tandem-config get                 print settings + detected monitors as JSON
#                                     plus "configured": has setup ever run
#   tandem-config set <key> <value>   update one key, then regenerate config
#   tandem-config set-json <object>   update several keys in one go
#
# Keys: desktops (1-10), toggle, send (key specs), numbers, tab, scroll (bools),
#       labels (JSON array of names, or null for the D1..Dn default),
#       animation (the Hyprland workspace style), mode (horizontal|vertical: the
#       way the monitors are arranged, which the popup follows),
#       scale (60-140: the panel size slider, % of the default; the text follows),
#       presets (bool; use the classic density and fontSize choices instead),
#       density (compact|normal|roomy), fontSize (small|normal|large),
#       popup (bool; the on-screen pager shown after a switch),
#       indicator (boxes|text; how the bar shows the desktops),
#       divider (bool; a thin line after the last desktop in the bar),
#       windowIcons (bool; app icons for what is open, in the bar),
#       clickToSwitch (bool; clicking a desktop in the bar goes to it),
#       accent (theme|blue|cyan|green|magenta|yellow|red|orange: the colour
#       Tandem highlights with; "theme" is the theme's own accent),
#       panelAccent, indicatorAccent (bool; false draws the panel, or the bar
#       indicator and popup, in the plain bar foreground).
#
# labels, scale, presets, density, fontSize, mode, popup, indicator, divider, windowIcons, clickToSwitch, accent, panelAccent and indicatorAccent are display settings: the panel and
# the bar widget read them live from shell.json, so changing only those never
# touches Hyprland.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHELL_JSON="${OMARCHY_SHELL_JSON:-$HOME/.config/omarchy/shell.json}"

command -v jq >/dev/null || { echo "tandem-config: jq is required" >&2; exit 1; }
[[ -f $SHELL_JSON ]] || { echo "tandem-config: $SHELL_JSON not found" >&2; exit 1; }

settings() {
  # Bar entries carry widget settings as flat keys (BarModel.entrySettings
  # copies every key but id), so that is where these live. Any older nested
  # "settings" object is merged up and dropped on the next write.
  jq -c '[.. | objects | select(.id == "videinfra.tandem" and (.role // "") != "settings") | (del(.id) | del(.settings)) + (.settings // {})] | first // {}' "$SHELL_JSON"
}

case "${1:-get}" in
get)
  # "Configured" means setup has produced a Hyprland config. A fresh
  # `omarchy plugin add` leaves the widget in the bar with none, and the
  # indicator offers to run the wizard instead of showing desktops.
  if [[ -f $HERE/tandem.lua ]]; then configured=true; else configured=false; fi
  monitors=$(hyprctl monitors -j 2>/dev/null \
    | jq -c 'sort_by(.y, .x) | [.[] | {name, width, height, x, y}]' 2>/dev/null || echo '[]')
  # Fill defaults so the panel never has to know them.
  version=$(jq -r '.version // ""' "$HERE/manifest.json" 2>/dev/null || true)
  # Workspace numbering. Omarchy 4.5 gives each monitor a block of ten, kept in
  # a state file keyed by connector; older versions interleave the desktops.
  # `bases` is each monitor's block start, in the order tandem uses.
  omarchy_dir="${OMARCHY_PATH:-/usr/share/omarchy}"
  ws_mode=interleaved
  blocks='{}'
  if [[ -f $omarchy_dir/default/hypr/monitor-workspaces.lua ]]; then
    ws_mode=blocks
    ws_state="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/monitor-workspaces"
    if [[ -f $ws_state ]]; then
      blocks=$(jq -Rn '[inputs | split("\t") | select(length >= 2) | {key: .[1], value: (.[0] | tonumber)}] | from_entries' "$ws_state" 2>/dev/null || echo '{}')
    fi
  fi
  settings | jq -c --argjson monitors "$monitors" --argjson configured "$configured" --arg version "$version" \
    --arg wsmode "$ws_mode" --argjson blocks "$blocks" '
    {
      desktops: (if has("desktops") and .desktops != null then .desktops else 2 end),
      toggle:   (if has("toggle")   and .toggle   != null then .toggle   else "SUPER + F" end),
      send:     (if has("send")     and .send     != null then .send     else "SUPER + SHIFT + F" end),
      numbers:  (if has("numbers")  and .numbers  != null then .numbers  else true end),
      tab:      (if has("tab")      and .tab      != null then .tab      else true end),
      scroll:   (if has("scroll")   and .scroll   != null then .scroll   else true end),
      animation:(if has("animation") and .animation!= null then .animation else "slide" end),
      density:  ((if .density == "comfortable" then "roomy" else .density end) as $d | if $d == "compact" or $d == "normal" or $d == "roomy" then $d else "normal" end),
      mode:     (if has("mode") and .mode != null then .mode else null end),
      fontSize: (if .fontSize == "small" or .fontSize == "normal" or .fontSize == "large" then .fontSize else "normal" end),
      scale:    ((if (.scale | type) == "number" then .scale elif (.density | type) == "number" then .density else 100 end) as $n
                 | if ($n | type) == "number" and $n >= 60 and $n <= 140 and $n == ($n | floor) then $n else 100 end),
      presets:  (if has("presets") and .presets != null then .presets else false end),
      popup:    (if has("popup") and .popup != null then .popup else false end),
      indicator: (if has("indicator") and .indicator != null then .indicator else "boxes" end),
      divider:  (if has("divider") and .divider != null then .divider else false end),
      windowIcons: (if has("windowIcons") and .windowIcons != null then .windowIcons else false end),
      accent:   (if has("accent") and .accent != null then .accent else "theme" end),
      clickToSwitch: (if has("clickToSwitch") and .clickToSwitch != null then .clickToSwitch else true end),
      panelAccent: (if has("panelAccent") and .panelAccent != null then .panelAccent else true end),
      indicatorAccent: (if has("indicatorAccent") and .indicatorAccent != null then .indicatorAccent else true end),
      monitors: (if has("monitors") and .monitors != null then .monitors else null end),
      labels:   (if has("labels")   and .labels   != null then .labels   else null end),
      detected: $monitors,
      configured: $configured,
      version: $version
    }
    | . + { workspaces: {
        mode: $wsmode,
        bases: (if $wsmode == "blocks"
          then [(.monitors // ($monitors | map(.name))) | to_entries[] | (($blocks[.value] // .key) * 10)]
          else [] end)
      } }'
  ;;

set | set-json)
  # Validate one key/value and echo it back as JSON. Shared by both writers so
  # a batched apply cannot sneak past the checks a single set enforces.
  validate() {
  local key=$1 value=$2
  case "$key" in
  desktops)
    [[ $value =~ ^[0-9]+$ ]] && (( value >= 1 && value <= 10 )) \
      || { echo "tandem-config: desktops must be 1-10" >&2; return 1; }
    json=$value
    ;;
  numbers | tab | scroll | popup | divider | windowIcons | clickToSwitch | panelAccent | indicatorAccent | presets)
    [[ $value == true || $value == false ]] \
      || { echo "tandem-config: $key must be true or false" >&2; return 1; }
    json=$value
    ;;
  labels)
    # A JSON array of names, one per desktop. Empty array clears back to D1..Dn.
    jq -e 'type == "array" and (length <= 10)
           and all(.[]; type == "string" and length > 0 and length <= 16
                        and (test("\"") | not))' <<<"$value" >/dev/null 2>&1 \
      || { echo "tandem-config: labels must be up to 10 names, 1-16 chars, no quotes" >&2; return 1; }
    json=$value
    ;;
  animation)
    case "$value" in
    slide | slidevert | fade | slidefade | slidefadevert | none) ;;
    *)
      echo "tandem-config: animation must be slide, slidevert, fade, slidefade, slidefadevert or none" >&2
      return 1
      ;;
    esac
    json=$(jq -nc --arg v "$value" '$v')
    ;;
  scale)
    # The panel size slider: a percentage of the default spacing, with the text
    # following it. Anything else reads back as 100.
    [[ $value =~ ^[0-9]+$ ]] && (( 10#$value >= 60 && 10#$value <= 140 )) \
      || { echo "tandem-config: scale must be a whole number from 60 to 140" >&2; return 1; }
    json=$(( 10#$value ))
    ;;
  density)
    case "$value" in
    compact | normal | roomy) ;;
    comfortable) value=roomy ;;   # the old name
    *) echo "tandem-config: density must be compact, normal or roomy" >&2; return 1 ;;
    esac
    json=$(jq -nc --arg v "$value" '$v')
    ;;
  accent)
    case "$value" in
    theme | blue | cyan | green | magenta | yellow | red | orange) ;;
    *) echo "tandem-config: accent must be theme, blue, cyan, green, magenta, yellow, red or orange" >&2; return 1 ;;
    esac
    json=$(jq -nc --arg v "$value" '$v')
    ;;
  indicator)
    case "$value" in
    boxes | text) ;;
    *) echo "tandem-config: indicator must be boxes or text" >&2; return 1 ;;
    esac
    json=$(jq -nc --arg v "$value" '$v')
    ;;
  mode)
    case "$value" in
    horizontal | vertical) ;;
    *) echo "tandem-config: mode must be horizontal or vertical" >&2; return 1 ;;
    esac
    json=$(jq -nc --arg v "$value" '$v')
    ;;
  fontSize)
    case "$value" in
    small | normal | large) ;;
    *) echo "tandem-config: fontSize must be small, normal or large" >&2; return 1 ;;
    esac
    json=$(jq -nc --arg v "$value" '$v')
    ;;
  toggle | send)
    [[ -n $value && $value != *'"'* ]] \
      || { echo "tandem-config: $key is not a usable key spec" >&2; return 1; }
    json=$(jq -nc --arg v "$value" '$v')
    ;;
  *)
    echo "tandem-config: unknown key '$key'" >&2; return 1 ;;
  esac
  printf '%s' "$json"
  }

  if [[ ${1} == set ]]; then
    key="${2:-}"; value="${3:-}"
    [[ -n $key ]] || { echo "tandem-config: set needs a key" >&2; exit 1; }
    validated=$(validate "$key" "$value") || exit 1
    patch=$(jq -nc --arg k "$key" --argjson v "$validated" '{($k): $v}')
  else
    # set-json takes one flat object and applies every key at once, so the
    # panel can batch several edits into a single regenerate + reload.
    raw="${2:-}"
    [[ -n $raw ]] || { echo "tandem-config: set-json needs a JSON object" >&2; exit 1; }
    jq -e 'type == "object"' <<<"$raw" >/dev/null 2>&1 \
      || { echo "tandem-config: set-json needs a JSON object" >&2; exit 1; }
    patch='{}'
    while IFS= read -r key; do
      [[ -n $key ]] || continue
      if [[ $key == labels ]]; then
        value=$(jq -c --arg k "$key" '.[$k]' <<<"$raw")
      else
        value=$(jq -r --arg k "$key" '.[$k] | if type == "string" then . else tostring end' <<<"$raw")
      fi
      validated=$(validate "$key" "$value") || exit 1
      patch=$(jq -nc --argjson p "$patch" --arg k "$key" --argjson v "$validated" '$p + {($k): $v}')
    done < <(jq -r 'keys[]' <<<"$raw")
  fi

  jq -e '[.. | objects | select(.id == "videinfra.tandem" and (.role // "") != "settings")] | length > 0' "$SHELL_JSON" >/dev/null \
    || { echo "tandem-config: widget not in shell.json -- add it to the bar first" >&2; exit 1; }

  cp "$SHELL_JSON" "$SHELL_JSON.bak.$(date +%s)"
  tmp=$(mktemp)
  jq --argjson patch "$patch" \
    '(.. | objects | select(.id == "videinfra.tandem" and (.role // "") != "settings")) |=
       ((del(.settings)) + (.settings // {}) + $patch)' \
    "$SHELL_JSON" >"$tmp"
  mv "$tmp" "$SHELL_JSON"

  # Display settings are read live by the panel and the bar widget, so there
  # is nothing to regenerate or reload.
  if [[ $(jq -r 'keys - ["labels", "density", "fontSize", "mode", "popup", "indicator", "divider", "windowIcons", "clickToSwitch", "accent", "panelAccent", "indicatorAccent", "scale", "presets"] | length' <<<"$patch") == 0 ]]; then
    echo "tandem-config: appearance updated"
    exit 0
  fi

  exec "$HERE/tandem-apply"
  ;;

*)
  echo "usage: tandem-config [get | set <key> <value>]" >&2
  exit 1
  ;;
esac
